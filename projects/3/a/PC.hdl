// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=currentvalue, out=incvalue);

    Mux16(a=currentvalue, b=incvalue, sel=inc, out=newvalue0);
    Mux16(a=newvalue0, b=in, sel=load, out=newvalue1);
    Mux16(a=newvalue1, b=false, sel=reset, out=newvalue2);

    Register(in=newvalue2, load=true, out=currentvalue, out=out);
}
